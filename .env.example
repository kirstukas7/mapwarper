# Copy to .env and fill in. Used by docker-compose.yml.

# Public domain name Traefik routes to the app. Point its DNS A/AAAA record
# at the VPS first.
DOMAIN=maps.example.com

# Must match your existing Traefik setup: the Docker network Traefik is on,
# its HTTPS entrypoint name, and its certificate resolver name.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# App image. Pin a tag such as ghcr.io/kirstukas7/mapwarper:sha-1a2b3c4 to
# avoid picking up new builds on pull.
MAPWARPER_IMAGE=ghcr.io/kirstukas7/mapwarper:latest

DB_NAME=mapwarper_production
DB_USER=mapwarper
DB_PASSWORD=change-me

# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=

# Puma worker processes (each handles one request at a time).
WEB_CONCURRENCY=2

REDIS_MAXMEMORY=512mb

# Outgoing mail (signup confirmations, password resets). Leave SMTP_ADDRESS
# empty to fall back to sendmail, which is not installed in the container.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
